<Window x:Class="CheckersApp.SimpleSkinsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CheckersApp"
        Title="Выбор скина" 
        Height="500" 
        Width="400"
        WindowStartupLocation="CenterScreen"
        Background="#1e1e1e"
        ResizeMode="NoResize"
        Icon="/Properties/dimaskin.jpeg">

    <Window.Resources>
        <local:ColorToBrushConverter x:Key="ColorToBrushConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Border Grid.Row="0" Background="#2d2d30" Padding="15">
            <TextBlock Text="🎨 Выберите стиль шашек" 
                       Foreground="White" 
                       FontSize="20" 
                       FontWeight="Bold"
                       HorizontalAlignment="Center"/>
        </Border>

        <!-- Список скинов -->
        <ScrollViewer Grid.Row="1" Margin="10">
            <ListBox x:Name="SkinsListBox"
                     Background="Transparent"
                     BorderThickness="0"
                     Foreground="White">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,5" Padding="10" Background="#2d2d30" CornerRadius="5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Превью -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,15,0">
                                    <Border Width="30" Height="30" 
                                            CornerRadius="15"
                                            Background="{Binding WhitePieceColor, Converter={StaticResource ColorToBrushConverter}}"
                                            BorderBrush="{Binding WhiteBorderColor, Converter={StaticResource ColorToBrushConverter}}"
                                            BorderThickness="2"
                                            Margin="0,0,5,0"/>
                                    <Border Width="30" Height="30" 
                                            CornerRadius="15"
                                            Background="{Binding BlackPieceColor, Converter={StaticResource ColorToBrushConverter}}"
                                            BorderBrush="{Binding BlackBorderColor, Converter={StaticResource ColorToBrushConverter}}"
                                            BorderThickness="2"/>
                                </StackPanel>

                                <!-- Информация -->
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Name}" 
                                               FontSize="14" 
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Description}" 
                                               FontSize="11" 
                                               Foreground="#a0c8e0"
                                               TextWrapping="Wrap"/>
                                </StackPanel>

                                <!-- Значок дамки -->
                                <TextBlock Grid.Column="2" 
                                           Text="{Binding KingSymbol}" 
                                           Foreground="{Binding KingColor, Converter={StaticResource ColorToBrushConverter}}"
                                           FontSize="16"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </ScrollViewer>

        <!-- Кнопки -->
        <Border Grid.Row="2" Background="#2d2d30" Padding="15">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="OKButton" 
                        Content="Применить" 
                        Click="OKButton_Click"
                        Width="120" Height="35"
                        Background="#4a6fa5" 
                        Foreground="White"
                        FontWeight="SemiBold"
                        Margin="0,0,10,0"/>

                <Button x:Name="CancelButton" 
                        Content="Отмена" 
                        Click="CancelButton_Click"
                        Width="120" Height="35"
                        Background="#555" 
                        Foreground="White"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>