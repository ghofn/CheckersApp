<Window x:Class="CheckersApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CheckersApp"
        Title="Английские шашки" Height="750" Width="850"
        WindowStartupLocation="CenterScreen"
        Background="#1e1e1e">

    <Window.Resources>
        <!-- Конвертер для цвета клетки с учетом подсветки -->
        <local:CellColorConverter x:Key="CellColorConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
            <Button x:Name="BackToMenuButton" 
                    Content="← В меню" 
                    Click="BackToMenuButton_Click" 
                    Padding="10,5"
                    Background="#555" 
                    Foreground="White"
                    Margin="0,0,20,0"/>

            <TextBlock Text="Английские шашки" 
                       FontSize="20" 
                       Foreground="White" 
                       FontWeight="Bold"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Игровое поле -->
        <ItemsControl x:Name="BoardItemsControl" 
                      Grid.Row="1" 
                      Margin="20">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="8" Columns="8"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="#555" BorderThickness="1" 
                            Width="70" Height="70"
                            MouseDown="Border_MouseDown">

                        <!-- Фон клетки с учетом подсветки -->
                        <Border.Background>
                            <Binding Converter="{StaticResource CellColorConverter}"/>
                        </Border.Background>

                        <!-- Шашка -->
                        <Grid>
                            <!-- Основная шашка -->
                            <Ellipse Width="45" Height="45" 
                                     Fill="{Binding PieceColor, Converter={StaticResource ColorToBrushConverter}}" 
                                     Stroke="{Binding PieceBorderColor, Converter={StaticResource ColorToBrushConverter}}" 
                                     StrokeThickness="2"
                                     Visibility="{Binding HasPiece, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsKing}" Value="True">
                                                <Setter Property="Stroke" Value="Gold"/>
                                                <Setter Property="StrokeThickness" Value="3"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>

                            <!-- Коронка для дамки -->
                            <TextBlock Text="♛" 
                                       FontSize="20" 
                                       Foreground="Gold" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center"
                                       Visibility="{Binding IsKing, Converter={StaticResource BooleanToVisibilityConverter}}"
                                       FontWeight="Bold"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Статусная панель -->
        <Border Grid.Row="2" Background="#2d2d30" Padding="10" Margin="0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock x:Name="StatusText" 
                           Text="Ход белых" 
                           Foreground="White" 
                           FontSize="16" 
                           Margin="0,0,20,0"
                           VerticalAlignment="Center"/>

                <Button x:Name="RestartButton" 
                        Content="Новая игра" 
                        Click="RestartButton_Click" 
                        Padding="15,8"
                        Background="#0078d4" 
                        Foreground="White"
                        FontWeight="SemiBold"/>

                <Button x:Name="HintButton" 
                  Content="💡 Подсказка" 
                  Click="HintButton_Click" 
                  Padding="15,8"
                  Background="#107c10" 
                  Foreground="White"
                  FontWeight="SemiBold"
                  Margin="10,0,0,0"/>
                <Button x:Name="UndoButton" 
                    Content="↶ Отмена хода" 
                    Click="UndoButton_Click" 
                    Padding="15,8"
                    Background="#d13438" 
                    Foreground="White"
                    FontWeight="SemiBold"
                    Margin="10,0,0,0"
                    ToolTip="Отменить последний ход (Ctrl+Z)"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>