<Window x:Class="CheckersApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Английские шашки" Height="750" Width="850"
        WindowStartupLocation="CenterScreen"
        Background="#1e1e1e">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0" Background="#2d2d30" Padding="10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="BackToMenuButton" 
                        Content="← Меню" 
                        Click="BackToMenuButton_Click" 
                        Padding="15,8"
                        Background="#555" 
                        Foreground="White"
                        FontWeight="SemiBold"
                        Margin="0,0,10,0"/>

                <TextBlock Text="Английские шашки" 
                           FontSize="22" 
                           Foreground="White" 
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"/>

                <Button x:Name="HintButton" 
                        Content="🤖 Подсказка" 
                        Click="HintButton_Click" 
                        Padding="15,8"
                        Background="#9c27b0" 
                        Foreground="White"
                        FontWeight="SemiBold"
                        Margin="0,0,10,0"
                        ToolTip="Показать рекомендуемый ход"/>

                <Button x:Name="RestartButton" 
                        Content="🔄 Новая игра" 
                        Click="RestartButton_Click" 
                        Padding="15,8"
                        Background="#0078d4" 
                        Foreground="White"
                        FontWeight="SemiBold"/>
            </StackPanel>
        </Border>

        <!-- Игровое поле -->
        <ItemsControl x:Name="BoardItemsControl" 
                      Grid.Row="1" 
                      Margin="20">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="8" Columns="8"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="#444" BorderThickness="1" 
                Width="70" Height="70"
                MouseDown="Border_MouseDown">

                        <Border.Background>
                            <Binding Path="Color" Converter="{StaticResource ColorToBrushConverter}"/>
                        </Border.Background>

                        <Grid>
                            <Rectangle Fill="#9c27b0" Opacity="0.4" 
                          Visibility="{Binding IsHighlighted, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                            <!-- Шашка -->
                            <Ellipse Width="45" Height="45" 
                         Fill="{Binding PieceColor, Converter={StaticResource ColorToBrushConverter}}" 
                         Stroke="{Binding PieceBorderColor, Converter={StaticResource ColorToBrushConverter}}" 
                         StrokeThickness="2"
                         Visibility="{Binding HasPiece, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsKing}" Value="True">
                                                <Setter Property="Stroke" Value="Gold"/>
                                                <Setter Property="StrokeThickness" Value="3"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Статусная панель -->
        <Border Grid.Row="2" Background="#2d2d30" Padding="10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock x:Name="StatusText" 
                           Text="Ход белых" 
                           Foreground="White" 
                           FontSize="16" 
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>