<Window x:Class="CheckersApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Английские шашки" Height="700" Width="800"
        WindowStartupLocation="CenterScreen"
        Background="#1e1e1e">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
    <Button x:Name="BackToMenuButton" 
            Content="← В меню" 
            Click="BackToMenuButton_Click" 
            Padding="10,5"
            Background="#555" 
            Foreground="White"
            Margin="0,0,20,0"/>
    
    <TextBlock x:Name="TitleText" 
               Text="Английские шашки" 
               FontSize="20" 
               Foreground="White" 
               FontWeight="Bold"
               VerticalAlignment="Center"/>
</StackPanel>
        <!-- Игровое поле -->
        <ItemsControl x:Name="BoardItemsControl" 
                      Grid.Row="1" 
                      Margin="20">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="8" Columns="8"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="#555" BorderThickness="1" 
                            Width="60" Height="60"
                            MouseDown="Border_MouseDown">
                        <Border.Background>
                            <SolidColorBrush Color="{Binding Color}"/>
                        </Border.Background>

                        <Ellipse Width="45" Height="45" 
                                 Fill="{Binding PieceColor, Converter={StaticResource ColorToBrushConverter}}" 
                                 Stroke="{Binding PieceBorderColor, Converter={StaticResource ColorToBrushConverter}}" 
                                 StrokeThickness="2"
                                 Visibility="{Binding HasPiece, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsKing}" Value="True">
                                            <Setter Property="Stroke" Value="Gold"/>
                                            <Setter Property="StrokeThickness" Value="3"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Статусная панель -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
            <TextBlock x:Name="StatusText" 
               Text="Ход белых" 
               Foreground="White" 
               FontSize="16" 
               Margin="0,0,20,0"/>

            <!-- Добавим отладочную информацию -->
            <TextBlock x:Name="DebugText"
               Text="" 
               Foreground="Yellow" 
               FontSize="12"
               VerticalAlignment="Center"
               Margin="0,0,20,0"/>

            <Button x:Name="RestartButton" 
            Content="Новая игра" 
            Click="RestartButton_Click" 
            Padding="10,5"
            Background="#0078d4" 
            Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>