<Window x:Class="CheckersApp.MainMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CheckersApp"
        Title="Шашки | Главное меню" 
        Height="700" 
        Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#1e1e1e"
        ResizeMode="NoResize"
        Icon="/Properties/Дмитрий_Солдатов.jpg">

    <Window.Resources>
        <Style x:Key="MenuButton" TargetType="Button">
            <Setter Property="Background" Value="#4a6fa5"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="Margin" Value="0,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#5a80b5"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DifficultyButton" TargetType="RadioButton">
            <Setter Property="Background" Value="#333"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="#555"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="BorderBrush" Value="#4a6fa5"/>
                    <Setter Property="Background" Value="#3a6095"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#444"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Основной контент -->
        <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center" Width="350">
            <!-- Заголовок -->
            <TextBlock Text="ШАШКИ" 
                       FontSize="42" 
                       Foreground="White" 
                       FontWeight="Bold" 
                       HorizontalAlignment="Center" 
                       Margin="0,0,0,40"
                       TextAlignment="Center"/>

            <!-- Подзаголовок -->
            <TextBlock Text="Классическая игра" 
                       FontSize="18" 
                       Foreground="#a0c8e0" 
                       HorizontalAlignment="Center" 
                       Margin="0,0,0,30"/>

            <!-- Выбор сложности -->
            <TextBlock Text="Уровень сложности:" 
                       FontSize="16" 
                       Foreground="White" 
                       Margin="0,0,0,10"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,30">
                <RadioButton x:Name="EasyButton" Content="Легкий" 
                           Style="{StaticResource DifficultyButton}"
                           GroupName="Difficulty" Tag="Easy"/>
                <RadioButton x:Name="MediumButton" Content="Средний" 
                           Style="{StaticResource DifficultyButton}"
                           GroupName="Difficulty" Tag="Medium" IsChecked="True"/>
                <RadioButton x:Name="HardButton" Content="Сложный" 
                           Style="{StaticResource DifficultyButton}"
                           GroupName="Difficulty" Tag="Hard"/>
            </StackPanel>

            <!-- Кнопки меню -->
            <Button x:Name="PlayVsAIButton" 
                    Content="🤖 Играть против ИИ" 
                    Click="PlayVsAIButton_Click"
                    Style="{StaticResource MenuButton}"/>

            <Button x:Name="PlayTwoPlayersButton" 
                    Content="👥 Два игрока" 
                    Click="PlayTwoPlayersButton_Click"
                    Style="{StaticResource MenuButton}"/>

            <Button x:Name="SkinsButton" 
                    Content="🎨 Скины шашек" 
                    Click="SkinsButton_Click"
                    Style="{StaticResource MenuButton}"/>

            <Button x:Name="MusicToggleButton" 
                    Content="🎵 Звуки: ВКЛ" 
                    Click="MusicToggleButton_Click"
                    Style="{StaticResource MenuButton}"/>

            <Button x:Name="ExitButton" 
                    Content="🚪 Выход" 
                    Click="ExitButton_Click"
                    Style="{StaticResource MenuButton}"/>
        </StackPanel>

        <!-- Нижняя панель -->
        <Border Grid.Row="1" Background="#2d2d30" Padding="10">
            <TextBlock Text="Шашки v0.1 © 2025" 
                       Foreground="#a0c8e0" 
                       FontSize="12"
                       HorizontalAlignment="Center"/>
        </Border>
    </Grid>
</Window>