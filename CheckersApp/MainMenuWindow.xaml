<Window x:Class="CheckersApp.MainMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Английские шашки" 
        Height="500" 
        Width="400"
        WindowStartupLocation="CenterScreen"
        Background="#1e1e1e"
        ResizeMode="NoResize">

    <Window.Resources>
        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#0078d4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Margin" Value="0,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="50"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#106ebe"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ExitButtonStyle" TargetType="Button" BasedOn="{StaticResource MenuButtonStyle}">
            <Setter Property="Background" Value="#d13438"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#b02a2e"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="300">
            <!-- Заголовок -->
            <TextBlock Text="Английские шашки" 
                       FontSize="28" 
                       Foreground="White" 
                       FontWeight="Bold" 
                       HorizontalAlignment="Center" 
                       Margin="0,0,0,30"/>

            <!-- Кнопки меню -->
            <Button x:Name="PlayVsAIButton" 
                    Content="Играть против ИИ" 
                    Click="PlayVsAIButton_Click"
                    Style="{StaticResource MenuButtonStyle}"/>

            <Button x:Name="PlayTwoPlayersButton" 
                    Content="Два игрока" 
                    Click="PlayTwoPlayersButton_Click"
                    Style="{StaticResource MenuButtonStyle}"/>

            <Button x:Name="SettingsButton" 
                    Content="Настройки" 
                    Click="SettingsButton_Click"
                    Style="{StaticResource MenuButtonStyle}"/>

            <Button x:Name="ExitButton" 
                    Content="Выход" 
                    Click="ExitButton_Click"
                    Style="{StaticResource ExitButtonStyle}"/>
        </StackPanel>
    </Grid>
</Window>